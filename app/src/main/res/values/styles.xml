<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Soundprint" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/soundprint_window_background</item>
        <item name="android:statusBarColor">@color/soundprint_window_background</item>
        <item name="android:navigationBarColor">@color/soundprint_window_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.Soundprint.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/soundprint_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="windowSplashScreenAnimationDuration">1</item>
        <item name="postSplashScreenTheme">@style/Theme.Soundprint</item>
    </style>
</resources>
