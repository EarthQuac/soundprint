<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Soundprint" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/soundprint_window_background</item>
        <item name="android:statusBarColor">@color/soundprint_window_background</item>
        <item name="android:navigationBarColor">@color/soundprint_window_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- Launch theme: plain colour, no icon, then swaps to Theme.Soundprint once the app draws. -->
    <style name="Theme.SoundprintStarting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/soundprint_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent_icon</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.Soundprint</item>
    </style>
</resources>
