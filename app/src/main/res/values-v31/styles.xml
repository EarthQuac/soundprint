<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 12+ owns a system splash window before Compose can draw.
        Use a transparent animated icon so the OS does not show the launcher
        icon as a separate static frame; the Compose Soundprint animation then
        becomes the first branded visual as soon as the activity is ready.
    -->
    <style name="Theme.Soundprint" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/soundprint_launch_background</item>
        <item name="android:statusBarColor">@color/soundprint_launch_background</item>
        <item name="android:navigationBarColor">@color/soundprint_launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>

        <item name="android:windowSplashScreenBackground">@color/soundprint_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
